<Window x:Class="NexusClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NexusClient"
        mc:Ignorable="d"
        Title="MainWindow"
        WindowStyle="None"
        Width="1920"
        Height="1080"
        WindowState="Maximized">
    <Grid>
        <Image HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="UniformToFill"/>

        <Border x:Name="NeonBorder"
        Width="300" Height="300"
        Background="Transparent"
        CornerRadius="10" Padding="20"
        RenderTransformOrigin="0.497,1.054"
        Margin="810,693,810,87"
        BorderThickness="3">

            <Border.BorderBrush>
                <SolidColorBrush Color="#00FFFF"/>
            </Border.BorderBrush>

            <Border.Triggers>
                <EventTrigger RoutedEvent="Border.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <ColorAnimationUsingKeyFrames
                        Storyboard.TargetName="NeonBorder"
                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                        Duration="0:0:2.5">
                                <DiscreteColorKeyFrame KeyTime="0:0:0.0" Value="#00FFFF"/>
                                <!-- neon cyan -->
                                <DiscreteColorKeyFrame KeyTime="0:0:0.5" Value="#FF00FF"/>
                                <!-- neon magenta -->
                                <DiscreteColorKeyFrame KeyTime="0:0:1.0" Value="#39FF14"/>
                                <!-- neon green -->
                                <DiscreteColorKeyFrame KeyTime="0:0:1.5" Value="#FFFF00"/>
                                <!-- neon yellow -->
                                <DiscreteColorKeyFrame KeyTime="0:0:2.0" Value="#FF3131"/>
                                <!-- neon red -->
                            </ColorAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>

            <StackPanel>
                <TextBlock Text="Welcome to NexusClient" FontSize="24" Foreground="White" HorizontalAlignment="Center"/>
                <Button Content="Start" Width="100" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
